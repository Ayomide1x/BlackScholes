# Inside the container: serve the built site, and pass /api to the calibration
# API on the Compose network. HTTPS is the VM's shared Caddy's job.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	# Responses without their own caching rule must be revalidated.
	header ?Cache-Control "no-cache"

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Vite fingerprints everything under /assets, so it can be cached forever.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
